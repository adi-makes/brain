# Root environment template. Copy to .env for local development.
# .env is gitignored. Do not create env files inside apps/, services/, or packages/.
# CI reads GitHub Actions secrets and variables, not this file.

APP_ENV=local
LOG_LEVEL=info
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WORKER_HEALTH_PORT=8001

# Public values only. Never put service-role keys, Gemini keys, or private
# credentials in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_APP_NAME=Second Brain

# Phase 02 — hosted Supabase. Fill these in the gitignored root .env only.
# The anon key is public. The service-role key must never use a NEXT_PUBLIC_ name.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGIN=http://127.0.0.1:3000

# Phase 07 — model providers. Do not prefix these with NEXT_PUBLIC_.
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
